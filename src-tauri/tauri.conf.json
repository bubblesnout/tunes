{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunes",
  "version": "0.1.0",
  "identifier": "au.tunes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tunes",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 540,
        "fullscreen": true,
        "decorations": false,
        "backgroundColor": "#0e141b",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
